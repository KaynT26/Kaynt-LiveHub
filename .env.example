# ===================== Kaynt Live Observer – cấu hình =====================
# Copy file này thành .env rồi điền. File .env KHÔNG được commit (đã có trong .gitignore).

# ---------- Truy cập qua WiFi / mạng LAN
# HOST=0.0.0.0  → điện thoại/máy khác cùng WiFi mở được app (link hiện trong cửa sổ đen & nút 📶 trên web)
# HOST=127.0.0.1 → chỉ máy này dùng được
HOST=0.0.0.0
PORT=5000
# Mật khẩu cho máy khác (máy này không cần nhập). Trình duyệt sẽ hỏi: tên đăng nhập gõ gì cũng được.
# ĐỂ TRỐNG = ai cùng WiFi cũng xem & điều khiển được app → nên đặt, nhất là khi dùng sessionid.
ACCESS_PASSWORD=

# ---------- API key Euler Stream (máy chủ ký mà TikTokLive dùng để kết nối)
# Không có key: dùng gói miễn phí, dễ bị giới hạn (rate-limit) khi xem nhiều phòng / kết nối lại nhiều.
# Tạo key tại https://www.eulerstream.com (Dashboard → API Keys), dán vào dưới đây:
SIGN_API_KEY=
# SIGN_API_URL=https://api.eulerstream.com   # chỉ đổi nếu dùng máy chủ ký khác

# ---------- sessionid: đăng nhập TikTok để xem live GIỚI HẠN ĐỘ TUỔI (18+)
# Lấy trong Chrome đã đăng nhập tiktok.com: F12 → Application → Cookies → https://www.tiktok.com
#   sessionid      → TIKTOK_SESSIONID
#   tt-target-idc  → TIKTOK_TARGET_IDC   (vd: alisg, useast2a, eu-ttp2)
TIKTOK_SESSIONID=
TIKTOK_TARGET_IDC=

# Khi nào dùng sessionid:
#   auto   = chỉ khi phòng bị giới hạn độ tuổi (khuyên dùng)
#   always = luôn đăng nhập cho mọi phòng
#   off    = không dùng
TIKTOK_SESSION_MODE=auto

# BẮT BUỘC nếu dùng sessionid: TikTokLive gửi sessionid tới máy chủ ký Euler Stream để ký kết nối.
# sessionid = toàn quyền truy cập tài khoản TikTok. Chỉ bật nếu bạn chấp nhận rủi ro này
# (nên dùng tài khoản phụ). Bỏ dấu # ở dòng dưới để đồng ý:
# WHITELIST_AUTHENTICATED_SESSION_ID_HOST=api.eulerstream.com

# ---------- khác (tuỳ chọn)
# MAX_ROOMS=8             # số phòng tối đa cùng lúc
